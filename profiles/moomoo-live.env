# Moomoo LIVE brokerage — real money via OpenD.
# Activate: export AOA_PROFILE=moomoo-live
# Then put MOOMOO_UNLOCK_PASSWORD and AOA_LIVE_ACK in local .env only (never commit).
#
# Prerequisites:
#   1. OpenD running and logged into your LIVE Moomoo account
#   2. Trading unlock password set in Moomoo / OpenD
#   3. AOA_LIVE_ACK=I_UNDERSTAND in .env
#   4. MOOMOO_UNLOCK_PASSWORD=... in .env
#
# Verify: AOA_PROFILE=moomoo-live aoa doctor
# First live cycle: AOA_PROFILE=moomoo-live aoa run

AOA_ENV=live
AOA_BROKER=moomoo
AOA_DRY_RUN=false
MOOMOO_LIVE=true
ALPACA_LIVE=false
AOA_DATA_DIR=data
AOA_JOURNAL_PATH=data/live/journal/aoa.jsonl
MOOMOO_OPEND_HOST=127.0.0.1
MOOMOO_OPEND_PORT=11111
MOOMOO_MARKET=US
MOOMOO_SECURITY_FIRM=FUTUINC
# Leave password blank here — set only in .env:
# MOOMOO_UNLOCK_PASSWORD=
# Optional account selection when you have multiple:
# MOOMOO_ACC_ID=0
# MOOMOO_ACC_INDEX=0

# Swarm memory stack — always on
AOA_PLASTICITY_ENABLED=true
AOA_STUDY_USAGE_ENABLED=true
AOA_STUDY_USAGE_BASELINE=true
AOA_STUDY_USAGE_LIMIT=8
AOA_TRADING_AGENTS_ENABLED=true
AOA_PARALLEL_WORKERS=4

# Online LoRA-style conviction calibration from realized outcomes
AOA_ADAPT_ENABLED=true
AOA_ADAPT_PATH=data/live/signal_adapter.json
