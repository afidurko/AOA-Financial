# Live Moomoo brokerage — real money. Copy settings into .env; never commit secrets.
# Preferred activation: export AOA_PROFILE=moomoo-live
# See docs/how-to/moomoo-setup.md § Live trading.

AOA_ENV=live
AOA_BROKER=moomoo
AOA_DRY_RUN=false
MOOMOO_LIVE=true
ALPACA_LIVE=false
AOA_LIVE_ACK=I_UNDERSTAND
AOA_DATA_DIR=data
AOA_JOURNAL_PATH=data/live/journal/aoa.jsonl
MOOMOO_OPEND_HOST=127.0.0.1
MOOMOO_OPEND_PORT=11111
MOOMOO_MARKET=US
MOOMOO_SECURITY_FIRM=FUTUINC
# Required — set in local .env only (trading unlock PIN):
# MOOMOO_UNLOCK_PASSWORD=

# Swarm memory — always on (same as paper)
AOA_PLASTICITY_ENABLED=true
AOA_STUDY_USAGE_ENABLED=true
AOA_STUDY_USAGE_BASELINE=true
AOA_STUDY_USAGE_LIMIT=8
AOA_TRADING_AGENTS_ENABLED=true
