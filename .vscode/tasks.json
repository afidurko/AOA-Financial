{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AOA: tasks list (shortkeys)",
      "type": "shell",
      "command": "python3 -m aoa.cli tasks list",
      "group": "none",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "AOA: copy prompt L1",
      "type": "shell",
      "command": "python3 -m aoa.cli tasks show L1",
      "group": "none",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "AOA: copy prompt L2",
      "type": "shell",
      "command": "python3 -m aoa.cli tasks show L2",
      "group": "none",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "AOA: run tier1 (deterministic)",
      "type": "shell",
      "command": "python3 -m aoa.cli tasks run tier1",
      "group": { "kind": "test", "isDefault": false },
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "AOA: run tier1-check",
      "type": "shell",
      "command": "python3 -m aoa.cli tasks run tier1-check",
      "group": "test",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "AOA: run tier2-check",
      "type": "shell",
      "command": "python3 -m aoa.cli tasks run tier2-check",
      "group": "test",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "AOA: verify (ruff + pytest)",
      "type": "shell",
      "command": "python3 -m aoa.cli tasks run verify",
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "AOA: workloop upgrade (dry-run)",
      "type": "shell",
      "command": "python3 -m aoa.cli workloop upgrade --dry-run",
      "group": "test",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "AOA: knowledge-stack setup",
      "type": "shell",
      "command": "./scripts/knowledge-stack-setup.sh",
      "group": "none",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "AOA: write multi-root workspace",
      "type": "shell",
      "command": "./scripts/write-aoa-workspace.sh",
      "group": "none",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "AOA: verify knowledge stack",
      "type": "shell",
      "command": "./scripts/verify-knowledge-stack.sh",
      "group": "test",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "AOA: attl init (brain workspace)",
      "type": "shell",
      "command": "python3 -m aoa.cli attl init",
      "group": "none",
      "presentation": { "reveal": "always", "panel": "shared" }
    }
  ]
}
